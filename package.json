{
  "name": "stick-duel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stick Duel \u2014 a juicy turn-based 2D physics duel with stick-figure ragdolls, six worlds and six bosses.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames",
    "build:gd": "tsc --noEmit && vite build --mode gd",
    "build:gamepix": "tsc --noEmit && vite build --mode gamepix",
    "zip": "node scripts/zip-dist.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:gamepix": "playwright test -c playwright.gamepix.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "covers": "node scripts/covers.mjs",
    "videos": "node scripts/videos.mjs",
    "qa": "node scripts/qa-shots.mjs",
    "check:build": "node scripts/check-build.mjs",
    "submission": "node scripts/submission.mjs",
    "submission:gd": "node scripts/submission-gd.mjs",
    "submission:gamepix": "node scripts/submission-gamepix.mjs",
    "thumbnails:gd": "node scripts/thumbnails-gd.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/fredoka": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "planck": "^1.5.1"
  }
}
