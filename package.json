{
  "name": "topple-duel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Topple Duel — a turn-based 2.5D physics duel: cut ropes, topple towers and set off barrels to knock out your rival.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames",
    "build:gd": "tsc --noEmit && vite build --mode gd",
    "build:gamepix": "tsc --noEmit && vite build --mode gamepix",
    "zip": "node scripts/zip-dist.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:gamepix": "playwright test -c playwright.gamepix.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:build": "node scripts/check-build.mjs",
    "submission": "node scripts/submission.mjs",
    "submission:gd": "node scripts/submission-gd.mjs",
    "submission:gamepix": "node scripts/submission-gamepix.mjs",
    "assets": "node scripts/pack-assets.mjs",
    "levels:check": "vitest run -c vitest.levels.config.ts tests/levels/forest.test.ts tests/levels/castle.test.ts tests/levels/mountains.test.ts tests/levels/desert.test.ts tests/levels/frozen.test.ts tests/levels/volcano.test.ts; node scripts/levels-report.mjs",
    "media": "node scripts/media.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/fredoka": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "eslint": "^10.14.0",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "planck": "^1.5.1",
    "three": "^0.170.0"
  }
}
