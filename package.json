{
  "name": "stick-duel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stick Duel — a juicy turn-based 2D physics duel with stick-figure ragdolls, six worlds and six bosses.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames",
    "build:gd": "tsc --noEmit && vite build --mode gd",
    "build:gamepix": "tsc --noEmit && vite build --mode gamepix",
    "build:web": "tsc --noEmit && vite build --mode web",
    "build:playgama": "tsc --noEmit && vite build --mode playgama",
    "build:gamemonetize": "tsc --noEmit && vite build --mode gamemonetize",
    "build:y8": "tsc --noEmit && vite build --mode y8",
    "zip": "node scripts/zip-dist.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:gamepix": "playwright test -c playwright.gamepix.config.ts",
    "test:e2e:gamemonetize": "playwright test -c playwright.gamemonetize.config.ts --trace off",
    "test:e2e:y8": "playwright test -c playwright.y8.config.ts --trace off",
    "check": "npm run lint && npm run typecheck && npm run test",
    "covers": "node scripts/covers.mjs",
    "videos": "node scripts/videos.mjs",
    "qa": "node scripts/qa-shots.mjs",
    "check:build": "node scripts/check-build.mjs",
    "submission": "node scripts/submission.mjs",
    "submission:gd": "node scripts/submission-gd.mjs",
    "submission:gamepix": "node scripts/submission-gamepix.mjs",
    "thumbnails:gd": "node scripts/thumbnails-gd.mjs",
    "submission:web": "npm run build:web && node scripts/web/zip.mjs",
    "check:web": "node scripts/web/check.mjs",
    "store:web": "node scripts/web/store.mjs",
    "submission:playgama": "npm run build:playgama && node scripts/playgama/zip.mjs",
    "check:playgama": "node scripts/playgama/check.mjs",
    "test:playgama": "node scripts/playgama/test.mjs",
    "qa:playgama": "node scripts/playgama/qa.mjs",
    "submission:gamemonetize": "npm run build:gamemonetize && node scripts/gamemonetize/zip.mjs",
    "check:gamemonetize": "node scripts/gamemonetize/check.mjs",
    "images:gamemonetize": "node scripts/gamemonetize/images.mjs",
    "submission:y8": "npm run build:y8 && node scripts/y8/zip.mjs",
    "check:y8": "node scripts/y8/check.mjs",
    "media:y8": "node scripts/y8/media.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/fredoka": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "planck": "^1.5.1"
  }
}
